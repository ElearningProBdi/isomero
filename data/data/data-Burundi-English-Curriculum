        {"unit": "U33", "title": "Burundi My Home", "canDo": "I can describe Burundi", "dialoguePlace": "Gitega", "readingText": "Burundi is a small country in East Africa. It has hills, lakes, and beautiful people. Our capital is Gitega. Bujumbura is the economic city. People speak Kirundi, French, and English. We grow coffee and tea. Burundi is called the Heart of Africa. I am proud to be Burundian.", "readingWords": 58, "vocab": ["Country", "Capital", "Proud", "Heart", "Grow"], "grammar": "Burundi is...", "tryAtHome": "Say 3 facts about Burundi"},
        {"unit": "U34", "title": "Coffee Farmers", "canDo": "I can talk about coffee", "dialoguePlace": "Coffee Hills", "readingText": "Many families in Burundi grow coffee. Farmers pick red cherries. They wash them. They dry them in the sun. Then they sell them. Coffee from Burundi is famous. People in other countries drink it. Coffee helps families earn money for school.", "readingWords": 54, "vocab": ["Coffee", "Farmers", "Pick", "Dry", "Famous"], "grammar": "Farmers pick...", "tryAtHome": "Explain how coffee is made"},
        {"unit": "U35", "title": "Drums of Burundi", "canDo": "I can talk about culture", "dialoguePlace": "Gishora", "readingText": "The drums of Burundi are famous in the world. At Gishora, drummers play big drums. They dance. They jump. The sound is powerful. Drums were used to call people and celebrate kings. Today, drums show our pride. When I hear drums, my heart beats fast.", "readingWords": 56, "vocab": ["Drums", "Celebrate", "Powerful", "Pride", "Culture"], "grammar": "Drums were used to...", "tryAtHome": "Beat rhythm and describe drums"},
        {"unit": "U36", "title": "My Town Bujumbura", "canDo": "I can describe town", "dialoguePlace": "Bujumbura", "readingText": "Bujumbura is near Lake Tanganyika. It is busy. There are markets, schools, and hospitals. People sell fish, fruit, and clothes. In the evening, people walk near the lake. The sunset is beautiful. I love Bujumbura. It is my home. Mary and John work in Bujumbura.", "readingWords": 56, "vocab": ["Busy", "Markets", "Hospitals", "Sunset", "Walk"], "grammar": "There are markets...", "tryAtHome": "Describe your town"},
        {"unit": "U37", "title": "Helping My Community", "canDo": "I can talk about helping", "dialoguePlace": "Community", "readingText": "Last month, our school cleaned the road. We picked up plastic. We planted trees. The elders thanked us. Our community became clean. Helping is not only for adults. Adults and children can help too. Small actions make a big change. John and I led the cleaning.", "readingWords": 56, "vocab": ["Cleaned", "Planted", "Community", "Actions", "Change"], "grammar": "We picked up / We planted", "tryAtHome": "Pick up plastic near home"},
        {"unit": "U38", "title": "Animals in Burundi", "canDo": "I can talk about animals", "dialoguePlace": "Kibira Forest", "readingText": "In Kibira forest, there are monkeys and birds. In Ruvubu Park, there are hippos and crocodiles. We must protect animals. Animals are part of our heritage. If we cut all trees, animals will disappear. Let us protect nature.", "readingWords": 50, "vocab": ["Forest", "Protect", "Heritage", "Disappear", "Nature"], "grammar": "There are monkeys.", "tryAtHome": "Name 3 wild animals"},
        {"unit": "U39", "title": "My Work Rules", "canDo": "I can talk about rules", "dialoguePlace": "Work", "readingText": "At work, we must arrive on time. We must respect colleagues. We must not fight. We must keep the classroom clean. Rules help us work. If we follow rules, work is peaceful. I follow rules. I want to be a good teacher. John follows rules in his shop.", "readingWords": 54, "vocab": ["Rules", "Respect", "Follow", "Peaceful", "Arrive"], "grammar": "We must / We must not", "tryAtHome": "Say 3 work rules"},
        {"unit": "U40", "title": "A Trip to Ngozi", "canDo": "I can tell travel story", "dialoguePlace": "Ngozi", "readingText": "Last holiday, we travelled to Ngozi. The road was long. We saw hills and tea fields. We visited my aunt. She cooked delicious food. We played with cousins. I learned new songs. Travelling teaches us new things. John travelled with us.", "readingWords": 54, "vocab": ["Travelled", "Tea fields", "Cousins", "Holiday", "Road"], "grammar": "We travelled / We saw", "tryAtHome": "Tell about a trip"}
      ]
