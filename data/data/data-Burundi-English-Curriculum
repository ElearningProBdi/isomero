        {"unit": "U17", "title": "My Neighbours", "canDo": "I can talk about neighbours", "dialoguePlace": "Neighbourhood", "readingText": "My neighbours are kind. Mr. Nkurunziza lives next door. He grows bananas. Mrs. Niyonsaba sells bread. She is friendly. We greet each other every morning. We help each other. When Mama is sick, our neighbours help. Community is family.", "readingWords": 50, "vocab": ["Neighbour", "Kind", "Greet", "Help", "Community"], "grammar": "He lives next door.", "tryAtHome": "Greet a neighbour in English"},
        {"unit": "U18", "title": "At the Church", "canDo": "I can talk about Sunday", "dialoguePlace": "Church", "readingText": "On Sunday, we go to church. We sing. We pray. We listen to the pastor. I wear my best clothes. After church, we eat together. I see my friends. Sunday is a happy day. We thank God for our family.", "readingWords": 50, "vocab": ["Sunday", "Church", "Sing", "Pray", "Thank"], "grammar": "On Sunday, we go...", "tryAtHome": "Tell what you do on Sunday"},
        {"unit": "U19", "title": "The Doctor", "canDo": "I can say I am sick", "dialoguePlace": "Health Center", "readingText": "Irakoze is sick. His head hurts. His stomach hurts. Mama takes him to the doctor. The doctor says: Open your mouth. You need rest and water. Take this medicine. Irakoze rests. He drinks water. Now he feels better. Thank you, doctor!", "readingWords": 54, "vocab": ["Sick", "Head hurts", "Doctor", "Medicine", "Better"], "grammar": "My head hurts.", "tryAtHome": "Role play doctor visit"},
        {"unit": "U20", "title": "Transport", "canDo": "I can name transport", "dialoguePlace": "Bus Stop", "readingText": "We go to Gitega by bus. The bus is big. We go to school on foot. We walk. Sometimes we take a bicycle. My father has a moto. It is fast. I like to travel. Travelling is fun. But I must be careful on the road.", "readingWords": 54, "vocab": ["Bus", "Bicycle", "Moto", "Travel", "Careful"], "grammar": "We go by bus.", "tryAtHome": "Name 3 transports"},
        {"unit": "U21", "title": "My Village", "canDo": "I can describe village", "dialoguePlace": "Village", "readingText": "My grandmother lives in a village near Ngozi. The village is green. There are hills. There are cows. There is a river. People grow beans and maize. Children play football. I love to visit my grandmother. Village life is calm.", "readingWords": 52, "vocab": ["Village", "Hills", "River", "Maize", "Calm"], "grammar": "There is a river. / There are hills.", "tryAtHome": "Draw your village and describe"},
        {"unit": "U22", "title": "Seasons in Burundi", "canDo": "I can talk about seasons", "dialoguePlace": "Farm", "readingText": "In Burundi, we have rainy season and dry season. In rainy season, it rains a lot. Farmers plant beans. In dry season, it is sunny. We harvest. I like rainy season. The hills become green. Burundi is beautiful.", "readingWords": 50, "vocab": ["Rainy season", "Dry season", "Plant", "Harvest", "Farmers"], "grammar": "It rains a lot.", "tryAtHome": "Say season today"},
        {"unit": "U23", "title": "My Birthday", "canDo": "I can talk about birthday", "dialoguePlace": "Home", "readingText": "Today is my birthday! I am eight years old. Mama makes a cake. My friends come. We sing Happy Birthday. We dance. Irakoze gives me a book. I say thank you. I am happy. Birthday is a special day.", "readingWords": 48, "vocab": ["Birthday", "Cake", "Sing", "Dance", "Special"], "grammar": "I am eight years old.", "tryAtHome": "Sing Happy Birthday in English"},
        {"unit": "U24", "title": "Helping at Home", "canDo": "I can talk about chores", "dialoguePlace": "Home", "readingText": "At home, I help. I sweep the floor. I wash dishes. I fetch water. Irakoze helps too. He feeds the chickens. We help Mama. Mama says thank you. Helping is good. When we help, home is happy.", "readingWords": 48, "vocab": ["Help", "Sweep", "Wash dishes", "Fetch water", "Chores"], "grammar": "I sweep the floor.", "tryAtHome": "Do 1 chore and say it in English"}
      ]
    },
