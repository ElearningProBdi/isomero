        {"unit": "U9", "title": "In the Morning", "canDo": "I can talk about morning routine", "dialoguePlace": "Home", "readingText": "In the morning, I wake up. I wash my face. I brush my teeth. I put on my uniform. I eat breakfast. I take my bag. I go to school. I say goodbye to Mama. Goodbye, Mama! I walk with Irakoze. We are happy. Morning is good.", "readingWords": 56, "vocab": ["Wake up", "Wash", "Breakfast", "Uniform", "Goodbye"], "grammar": "I wake up / I go to school", "tryAtHome": "Tell your morning in 4 sentences"},
        {"unit": "U10", "title": "At School", "canDo": "I can talk about school day", "dialoguePlace": "School", "readingText": "At school, I learn. I read. I write. I sing. My teacher asks a question. I raise my hand. I answer. My friends listen. We play at break. We run. We laugh. At school, I am happy. I like to learn.", "readingWords": 52, "vocab": ["Learn", "Read", "Write", "Sing", "Play"], "grammar": "I read / I write", "tryAtHome": "Mime 3 school actions"},
        {"unit": "U11", "title": "My Friends", "canDo": "I can describe friends", "dialoguePlace": "Playground", "readingText": "This is my friend Aline. She is kind. She likes to sing. This is my friend Eric. He is funny. He likes to run. We play together. We share our books. We help each other. Friends are good. I love my friends.", "readingWords": 50, "vocab": ["Kind", "Funny", "Share", "Help", "Together"], "grammar": "She is kind. / He is funny.", "tryAtHome": "Describe 1 friend"},
        {"unit": "U12", "title": "My House", "canDo": "I can name rooms", "dialoguePlace": "Home", "readingText": "This is my house. It is small and beautiful. This is the kitchen. Mama cooks here. This is the bedroom. I sleep here. This is the living room. We talk here. I like my house. My house is clean.", "readingWords": 48, "vocab": ["House", "Kitchen", "Bedroom", "Living room", "Clean"], "grammar": "This is the kitchen.", "tryAtHome": "Name rooms in your house"},
        {"unit": "U13", "title": "Weather Today", "canDo": "I can talk about weather", "dialoguePlace": "Outside", "readingText": "Today it is sunny. The sun is hot. I wear a hat. Yesterday it was rainy. It rained a lot. We stayed inside. Tomorrow it will be cloudy. I like sunny days. I can play outside. What is the weather today?", "readingWords": 52, "vocab": ["Sunny", "Rainy", "Cloudy", "Hot", "Today"], "grammar": "It is sunny. / It was rainy.", "tryAtHome": "Look outside and say weather"},
        {"unit": "U14", "title": "My Clothes", "canDo": "I can name clothes", "dialoguePlace": "Bedroom", "readingText": "I wear a shirt. I wear trousers. I wear shoes. When it is cold, I wear a sweater. When it rains, I wear a raincoat. My uniform is blue and white. I like my clothes. My clothes are clean.", "readingWords": 48, "vocab": ["Shirt", "Trousers", "Shoes", "Sweater", "Uniform"], "grammar": "I wear a shirt.", "tryAtHome": "Name what you are wearing"},
        {"unit": "U15", "title": "Food Market", "canDo": "I can buy food", "dialoguePlace": "Bujumbura Market", "readingText": "Mama and I go to the market. We buy tomatoes. We buy onions. We buy beans. How much is this? The seller says: 2000 FBu. Mama pays. We say thank you. The market is busy. Many people are there. I like the market.", "readingWords": 52, "vocab": ["Market", "Buy", "How much", "Pay", "Seller"], "grammar": "How much is this?", "tryAtHome": "Role play buying tomatoes"},
        {"unit": "U16", "title": "My Evening", "canDo": "I can talk about evening", "dialoguePlace": "Home", "readingText": "In the evening, I go home. I wash my hands. I eat dinner with my family. I do my homework. I read a book. I say good night to Mama and Papa. Good night! I sleep. I dream of tomorrow.", "readingWords": 48, "vocab": ["Evening", "Dinner", "Homework", "Good night", "Sleep"], "grammar": "I do my homework.", "tryAtHome": "Tell evening routine"}
      ]
    },
