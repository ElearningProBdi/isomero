        {"unit": "U25", "title": "A Day with Grandma", "canDo": "I can tell a day story", "dialoguePlace": "Grandma Home", "readingText": "Yesterday I visited Grandma. She was cooking beans. I was helping her. She told me a story about a clever rabbit. The rabbit tricked a lion. I laughed. Grandma is wise. She knows many stories. I want to be wise like her. John also visits his grandmother.", "readingWords": 56, "vocab": ["Yesterday", "Wise", "Clever", "Tricked", "Story"], "grammar": "She was cooking.", "tryAtHome": "Tell story Grandma told you"},
        {"unit": "U26", "title": "The Lost Goat", "canDo": "I can tell past story", "dialoguePlace": "Hills", "readingText": "Last week, our goat was lost. We looked everywhere. We looked near the river. We looked in the hills. John was running. He was shouting: Goat! Goat! Finally, we found it near the banana trees. It was eating leaves. We were happy. We brought it home. As adults, we take care of our animals.", "readingWords": 62, "vocab": ["Lost", "Looked", "Found", "Finally", "Everywhere"], "grammar": "We looked / We found", "tryAtHome": "Tell about lost thing"},
        {"unit": "U27", "title": "Football Match", "canDo": "I can talk about sport", "dialoguePlace": "Stadium", "readingText": "On Saturday, we played football. My team was strong. John scored a goal. We shouted! The other team scored too. At the end, we won 2-1. We were happy. We shook hands. Football teaches teamwork. I love football. Adults also need sport for health.", "readingWords": 56, "vocab": ["Team", "Scored", "Goal", "Won", "Teamwork"], "grammar": "We won / He scored", "tryAtHome": "Describe last game"},
        {"unit": "U28", "title": "My Best Friend", "canDo": "I can describe person", "dialoguePlace": "Work", "readingText": "My best friend is Sara. She is tall and kind. She has black hair. She likes reading. She helps me with work. When I am sad, she makes me laugh. We walk to work together. I trust her. Best friends are a gift. John is also my good friend and colleague.", "readingWords": 56, "vocab": ["Tall", "Kind", "Trust", "Gift", "Laugh"], "grammar": "She has black hair.", "tryAtHome": "Describe best friend"},
        {"unit": "U29", "title": "At the Lake", "canDo": "I can talk about nature", "dialoguePlace": "Lake Tanganyika", "readingText": "Last holiday, we went to Lake Tanganyika. The water was blue. The sand was warm. We swam. We played. We ate fish. Fish from the lake is delicious. I saw boats. I saw birds. Bujumbura is beautiful near the lake. John and I go there to rest after work.", "readingWords": 56, "vocab": ["Lake", "Swam", "Sand", "Boats", "Delicious"], "grammar": "We went / We swam", "tryAtHome": "Describe a place you visited"},
        {"unit": "U30", "title": "Shopping with Mama", "canDo": "I can talk about shopping", "dialoguePlace": "Market", "readingText": "Yesterday Mama and I went shopping. We needed rice, oil, and soap. At the market, Mama compared prices. This rice is 3000 FBu. That one is cheaper. She bought the cheaper one. She is smart. We saved money. Shopping needs wisdom. John compares prices for his shop too.", "readingWords": 58, "vocab": ["Shopping", "Compared", "Cheaper", "Saved", "Price"], "grammar": "This is cheaper.", "tryAtHome": "Compare 2 prices at home"},
        {"unit": "U31", "title": "My Future Dream", "canDo": "I can talk about future", "dialoguePlace": "Classroom", "readingText": "When I grow in my career, I want to be a head teacher. I want to help adults and children learn English. I will study hard. I will read many books. I will be kind. My dream is big. Dreams need work. I will not give up. John also dreams to grow his business.", "readingWords": 56, "vocab": ["Future", "Dream", "Teacher", "Study hard", "Give up"], "grammar": "I will study / I want to be", "tryAtHome": "Say I want to be ___"},
        {"unit": "U32", "title": "Rainy Day", "canDo": "I can talk about weather past", "dialoguePlace": "Home", "readingText": "Yesterday it rained all day. We could not go outside. We stayed inside. Mama told stories. We played games. John drew a plan for his shop. I prepared lessons. Rainy days can be fun too. We learn to enjoy every day. As adults, we use rainy days to plan.", "readingWords": 56, "vocab": ["Rained", "Stayed", "Inside", "Enjoy", "Games"], "grammar": "It rained / We stayed", "tryAtHome": "Tell what you do when it rains"}
      ]
