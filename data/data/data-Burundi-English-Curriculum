      "units": [
        {"unit": "U1", "title": "Hello, I Am Keza", "canDo": "I can say hello and my name", "dialoguePlace": "Bujumbura Home", "readingText": "Hello! My name is Keza. I am five years old. I live in Bujumbura with my mother, my father, and my brother Irakoze. I like to smile. I like to say hello to my friends. Hello, friend! What is your name? My name is Keza. I am happy to meet you. Let us learn English together. English is fun. We can sing. We can play. We can say hello every day.", "readingWords": 68, "vocab": ["Hello", "Name", "Happy", "Friend", "Meet"], "grammar": "I am Keza. / I am happy.", "tryAtHome": "Say Hello, I am ___ to 3 people"},
        {"unit": "U2", "title": "My Family", "canDo": "I can name my family", "dialoguePlace": "Gitega Home", "readingText": "This is my family. This is my mother. She is kind. This is my father. He is strong. This is my brother Irakoze. He is funny. This is my grandmother. She tells stories. I love my family. My family loves me. We eat together. We laugh together. We help each other. Family is good.", "readingWords": 62, "vocab": ["Mother", "Father", "Brother", "Grandmother", "Love"], "grammar": "This is my mother.", "tryAtHome": "Point and name 4 family members"},
        {"unit": "U3", "title": "My Body", "canDo": "I can name body parts", "dialoguePlace": "School Yard", "readingText": "This is my head. These are my eyes. I can see with my eyes. This is my nose. This is my mouth. I can talk with my mouth. These are my hands. I can clap with my hands. These are my feet. I can run with my feet. My body is good. I take care of my body. I wash my hands. I brush my teeth.", "readingWords": 66, "vocab": ["Head", "Eyes", "Mouth", "Hands", "Feet"], "grammar": "This is my / These are my", "tryAtHome": "Touch and say 5 body parts"},
        {"unit": "U4", "title": "Colors Around Me", "canDo": "I can name colors", "dialoguePlace": "Market", "readingText": "Look! The sky is blue. The sun is yellow. The banana is yellow. The avocado is green. The tomato is red. The milk is white. The soil is brown. Burundi is beautiful. It has many colors. I like red. What color do you like? I like blue. Colors make me happy.", "readingWords": 59, "vocab": ["Red", "Blue", "Green", "Yellow", "White"], "grammar": "The banana is yellow.", "tryAtHome": "Find 3 red things at home"},
        {"unit": "U5", "title": "Numbers 1 to 10", "canDo": "I can count to 10", "dialoguePlace": "Classroom", "readingText": "One, two, three. Let us count. One mango. Two mangoes. Three mangoes. Four bananas. Five oranges. Six friends. Seven books. Eight pencils. Nine chairs. Ten fingers. I can count to ten. Counting is fun. Let us count again. One, two, three, four, five, six, seven, eight, nine, ten!", "readingWords": 52, "vocab": ["One", "Two", "Three", "Count", "Ten"], "grammar": "One mango / Two mangoes", "tryAtHome": "Count 10 beans at home"},
        {"unit": "U6", "title": "My School", "canDo": "I can name school things", "dialoguePlace": "Primary School", "readingText": "This is my school. I go to school in the morning. My teacher is good. My friends are here. This is my book. This is my pencil. This is my bag. I sit on a chair. I listen to my teacher. I learn English. I like school. School is fun.", "readingWords": 54, "vocab": ["School", "Teacher", "Book", "Pencil", "Bag"], "grammar": "This is my book.", "tryAtHome": "Name 5 things in your bag"},
        {"unit": "U7", "title": "Animals I Know", "canDo": "I can name animals", "dialoguePlace": "Farm", "readingText": "Look at the cow. The cow says moo. Look at the goat. The goat is small. Look at the chicken. The chicken says cluck. Look at the dog. The dog is my friend. I like animals. Animals are good. We take care of animals. We give them water and food.", "readingWords": 55, "vocab": ["Cow", "Goat", "Chicken", "Dog", "Farm"], "grammar": "The cow says moo.", "tryAtHome": "Make sounds of 3 animals"},
        {"unit": "U8", "title": "I Like Food", "canDo": "I can say what I like", "dialoguePlace": "Kitchen", "readingText": "I like rice. I like beans. I like bananas. I like milk. I do not like hot pepper. It is hot! My mother cooks good food. We eat together. I say thank you. Thank you, Mama. The food is good. I am happy.", "readingWords": 50, "vocab": ["Rice", "Beans", "Banana", "Milk", "Thank you"], "grammar": "I like / I do not like", "tryAtHome": "Say I like ___ for 3 foods"}
      ]
