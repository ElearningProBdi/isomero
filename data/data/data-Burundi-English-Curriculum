        {"unit": "U41", "title": "When I Was Young", "canDo": "I can tell story about past", "dialoguePlace": "Gitega Home", "readingText": "When Keza was five years old, she lived in Gitega with her grandmother. While her grandmother was cooking beans, Keza was playing outside. She was running with her brother. Suddenly, it started to rain. Keza was laughing. Her grandmother was calling: Come inside! They sat near the fire. Her grandmother told a story about a clever rabbit. Keza listened carefully. She still remembers that story. She says: When I was young, my grandmother taught me many stories. Those stories helped me love Burundi and its traditions.", "readingWords": 128, "vocab": ["While", "Suddenly", "Remember", "Tradition", "Story"], "grammar": "While I was playing", "tryAtHome": "Tell 1 story from when you were young, record"},
        {"unit": "U42", "title": "The Day I Learned to Swim", "canDo": "I can tell learning story", "dialoguePlace": "Lake Tanganyika", "readingText": "When I was eight, my father taught me to swim in Lake Tanganyika. At first, I was afraid. The water was deep. My father held my hand. He said: Breathe slowly. Kick your legs. I tried. I drank water. I coughed. Everyone laughed. But I did not give up. After one week, I could swim alone. I felt proud. Learning needs courage.", "readingWords": 72, "vocab": ["Afraid", "Deep", "Breathe", "Courage", "Proud"], "grammar": "At first / After one week", "tryAtHome": "Tell about something you learned"},
        {"unit": "U43", "title": "My First Day at School", "canDo": "I can talk about first day", "dialoguePlace": "School", "readingText": "I still remember my first day at school. I was nervous. My mother held my hand. I saw many children. My teacher smiled. She said: Welcome, Keza. I sat next to Aline. We became friends. That day, I learned to write my name. I was so happy. First days are scary but beautiful.", "readingWords": 62, "vocab": ["Nervous", "Welcome", "First day", "Smiled", "Scary"], "grammar": "I was nervous / She smiled", "tryAtHome": "Tell about first day"},
        {"unit": "U44", "title": "A Difficult Exam", "canDo": "I can talk about challenges", "dialoguePlace": "Classroom", "readingText": "Last term, I had a difficult English exam. I studied every evening. But on exam day, I forgot everything. My heart was beating fast. I took a deep breath. I read the questions slowly. I remembered. I answered. I passed. I learned that calm helps. When you are stressed, breathe.", "readingWords": 60, "vocab": ["Difficult", "Exam", "Forgot", "Calm", "Passed"], "grammar": "I had / I forgot", "tryAtHome": "Tell how you handle stress"},
        {"unit": "U45", "title": "Helping a Stranger", "canDo": "I can tell moral story", "dialoguePlace": "Market", "readingText": "One day at the market, I saw an old man. He was carrying a heavy bag. He was tired. I helped him. I carried his bag to the bus. He thanked me. He said: God bless you. I felt happy all day. Helping a stranger is a small act with big joy.", "readingWords": 58, "vocab": ["Stranger", "Heavy", "Tired", "Bless", "Joy"], "grammar": "He was carrying", "tryAtHome": "Help someone and tell story"},
        {"unit": "U46", "title": "My Role Model", "canDo": "I can describe role model", "dialoguePlace": "Home", "readingText": "My role model is my mother. She wakes up early. She works hard. She sells vegetables at the market. She pays for my school. She is honest. She never gives up. She teaches me to be kind and strong. I want to be like her.", "readingWords": 56, "vocab": ["Role model", "Honest", "Hard work", "Strong", "Kind"], "grammar": "She wakes up / She works", "tryAtHome": "Describe your role model"},
        {"unit": "U47", "title": "A Dream I Had", "canDo": "I can talk about dreams", "dialoguePlace": "Bedroom", "readingText": "Last night, I had a strange dream. I was flying over Burundi. I saw hills, lakes, and rivers. I saw my school from above. I landed in Gitega. Everyone was clapping. I woke up smiling. Dreams can inspire us. My dream is to help Burundi grow.", "readingWords": 56, "vocab": ["Dream", "Flying", "Strange", "Inspire", "Above"], "grammar": "I was flying", "tryAtHome": "Tell a dream you had"},
        {"unit": "U48", "title": "Learning from Mistakes", "canDo": "I can talk about mistakes", "dialoguePlace": "School", "readingText": "Once I broke my friend's pencil. I was afraid to tell her. I lied. Later I felt guilty. I told the truth. She forgave me. I learned that honesty is better than fear. Mistakes are teachers. We grow when we admit them.", "readingWords": 54, "vocab": ["Mistake", "Guilty", "Honest", "Forgave", "Admit"], "grammar": "I broke / I told", "tryAtHome": "Tell about a mistake you fixed"}
      ]
    },
